{
  "build": {
    "env": {
      "VITE_API_URL": "https://nazrul-academy-backend.vercel.app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nazrul-academy-backend.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
